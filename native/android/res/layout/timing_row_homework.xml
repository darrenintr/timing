<?xml version="1.0" encoding="utf-8"?>
<!-- A homework row: the circle completes it in place, the text opens it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical">
    <FrameLayout android:id="@+id/timing_row_check" android:layout_width="44dp" android:layout_height="44dp">
        <ImageView android:id="@+id/timing_row_ring" android:layout_width="22dp" android:layout_height="22dp"
            android:layout_gravity="center" android:src="@drawable/timing_ring" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:id="@+id/timing_row_open" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="4dp" android:orientation="vertical">
        <TextView android:id="@+id/timing_row_subject" style="@style/TimingBody" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/timing_row_time" style="@style/TimingBody" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/timing_ink2" />
    </LinearLayout>
    <TextView android:id="@+id/timing_row_place" style="@style/TimingMono" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="8dp" />
</LinearLayout>
