<?xml version="1.0" encoding="utf-8"?>
<!-- Timeline · 6×2: width becomes time; breaks are dots; now fills with teal. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/timing_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/timing_bg_surface" android:paddingStart="20dp" android:paddingEnd="20dp"
    android:paddingTop="16dp" android:paddingBottom="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/timing_badge" android:layout_width="40dp" android:layout_height="40dp"
            android:importantForAccessibility="no" />
        <TextView android:id="@+id/timing_title" style="@style/TimingSerif" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textSize="24sp" android:text="Friday" />
        <TextView android:id="@+id/timing_detail" style="@style/TimingBody" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/timing_ink2" android:text="25 September" />
        <TextView android:id="@+id/timing_eyebrow" style="@style/TimingEyebrow" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
            android:gravity="end" android:textColor="@color/timing_accent" android:text="Geography · 18 min left" />
    </LinearLayout>
    <LinearLayout android:id="@+id/timing_rows" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="14dp" />
    <TextView android:id="@+id/timing_foot" style="@style/TimingBody" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="14dp" android:gravity="center_vertical"
        android:maxLines="3" android:textSize="15sp" android:textColor="@color/timing_warm" android:visibility="gone" />
</LinearLayout>
