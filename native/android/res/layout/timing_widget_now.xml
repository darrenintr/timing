<?xml version="1.0" encoding="utf-8"?>
<!-- Now · 2×2: cycle cookie, the current lesson and its wavy progress. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/timing_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/timing_bg_surface" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="14dp" android:paddingBottom="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/timing_badge" android:layout_width="46dp" android:layout_height="46dp"
            android:importantForAccessibility="no" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/timing_corner" style="@style/TimingMono" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/timing_ink2" android:text="P4 · 10:15" />
    </LinearLayout>
    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/timing_eyebrow" style="@style/TimingEyebrow" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/timing_accent" android:text="Now · 18 min" />
    <TextView android:id="@+id/timing_title" style="@style/TimingSerif" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="26sp" android:text="Geography" />
    <TextView android:id="@+id/timing_detail" style="@style/TimingMono" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="GER · CK" />
    <ImageView android:id="@+id/timing_wave" android:layout_width="match_parent" android:layout_height="10dp"
        android:layout_marginTop="10dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <TextView android:id="@+id/timing_foot" style="@style/TimingBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="12sp"
        android:textColor="@color/timing_ink2" android:visibility="gone" />
</LinearLayout>
