<?xml version="1.0" encoding="utf-8"?>
<!-- Three voices: serif for what matters now, sans for reading, mono for times and rooms. -->
<resources>
    <style name="TimingEyebrow">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/timing_ink3</item>
    </style>
    <style name="TimingSerif">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/timing_ink</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TimingMono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/timing_ink3</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="TimingBody">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/timing_ink</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
