<?xml version="1.0" encoding="utf-8"?>
<!-- The current timeline block: teal, filling darker as the lesson runs. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="@color/timing_accent" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="@color/timing_accent_deep" /><corners android:radius="14dp" /></shape></clip>
    </item>
</layer-list>
