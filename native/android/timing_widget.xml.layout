<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timing_widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="@drawable/timing_widget_background">
    <TextView android:id="@+id/timing_date" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Timing · Today"
        android:textColor="#A6F1E8" android:textStyle="bold" android:textSize="16sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="TIMETABLE"
        android:textColor="#A6F1E8" android:textSize="10sp" />
    <TextView android:id="@+id/timing_lessons" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="top"
        android:maxLines="8" android:ellipsize="end" android:text="Open Timing to load your timetable."
        android:textColor="#FFFFFF" android:textSize="13sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="HOMEWORK"
        android:textColor="#A6F1E8" android:textSize="10sp" />
    <TextView android:id="@+id/timing_homework" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:maxLines="3" android:ellipsize="end"
        android:text="No upcoming homework" android:textColor="#FFFFFF" android:textSize="12sp" />
</LinearLayout>
